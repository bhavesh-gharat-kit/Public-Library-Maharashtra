// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Library {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  name      String
  email     String  @unique
  contactNo String?
  address   String?

  createdAt DateTime    @default(now())
  User      User[]
  Setting   Setting?
  AllowedIP AllowedIP[]

  @@map("libraries")
}

model Setting {
  id           Int      @id @default(autoincrement())
  libraryId    Int      @unique @db.UnsignedInt
  remoteAccess Boolean  @default(true) // true = allow access from anywhere
  updatedAt    DateTime @updatedAt

  Library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade) //Relation to Library Model

  @@map("library_settings") // Custom table name
}

enum Role {
  user
  admin
  superadmin
}

model User {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  libraryId Int     @db.UnsignedInt
  name      String
  email     String?
  userId    String  @unique
  contactNo String?
  password  String
  role      Role    @default(user)

  Library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("users")
}

model DailyInspiration {
  id     Int    @id @default(autoincrement()) @db.UnsignedInt
  quote  String
  author String

  createdAt DateTime @default(now())

  @@map("daily_inspiration") // Custom table name
}

enum BookType {
  eBook
  iBook
}

enum BookContentType {
  openAccess
  premium
}

model Book {
  id                Int  @id @default(autoincrement()) @db.UnsignedInt
  yearOfPublication Int?

  author    String?
  publisher String?

  medium   String?
  standard String?
  issn     String?
  subject  String?

  syllabus    String?
  title       String?
  description String?
  createdAt   DateTime @default(now())

  contentType BookContentType @default(openAccess)
  bookType    BookType        @default(eBook)

  pdfLink       String?
  thumbnailLink String?

  iBook IBook? @relation("BookToIBook")

  @@map("books") // Custom table name
}

model IBook {
  id     Int  @id @default(autoincrement()) @db.UnsignedInt
  bookId Int  @unique @db.UnsignedInt
  book   Book @relation("BookToIBook", fields: [bookId], references: [id], onDelete: Cascade) //Relation to Book Model

  summary         String? @db.Text
  notes           String? @db.Text
  revisionNotes   String? @db.Text
  commonMistakes  String? @db.Text
  studyTricks     String? @db.Text
  definitions     String? @db.Text
  suggestedVideos String? @db.Text
  mcq             String? @db.Text
  questionPaper   String? @db.Text
  questionAnswer  String? @db.Text

  createdAt DateTime @default(now())

  @@map("i_books") // Custom table name
}

model AllowedIP {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  libraryId Int      @db.UnsignedInt
  ipAddress String   @unique
  createdAt DateTime @default(now())

  Library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade) //Relation to Library Model

  @@map("allowed_ip_addresses") // Custom table name
}

model SuggestedBooks {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  content       String? @db.Text
  url           String?
  title         String?
  description   String?
  thumbnailLink String?

  createdAt DateTime @default(now())

  @@map("suggested_books") // Custom table name
}

model ExamCategory {
  id        Int                    @id @default(autoincrement()) @db.UnsignedInt
  slug      String?                @unique
  name      String
  mockTests MockTest[] // Tests for this category
  questions ExamCategoryQuestion[] // Pool of questions belonging to this category
  createdAt DateTime               @default(now())

  @@map("exam_categories")
}

model MockTest {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  title          String
  testType       TestType     @default(DAILY)
  examCategoryId Int          @db.UnsignedInt
  examCategory   ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)

  // No direct questions here – questions will be drawn from ExamCategoryQuestion dynamically
  date      DateTime? @db.Date
  createdAt DateTime?  @default(now())

  @@map("mock_tests")
}

model ExamCategoryQuestion {
  id             Int    @id @default(autoincrement()) @db.UnsignedInt
  examCategoryId Int    @db.UnsignedInt
  question       String @db.Text

  currentAffairsDate DateTime? @default(now()) // For Current Affairs only (null for other categories)

  examCategory ExamCategory     @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)
  options      MockTestOption[]
  answer       MockTestAnswer?

  @@map("exam_category_questions")
}

model MockTestOption {
  id         Int                  @id @default(autoincrement()) @db.UnsignedInt
  questionId Int                  @db.UnsignedInt
  text       String
  question   ExamCategoryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     MockTestAnswer[]

  @@map("mock_tests_options")
}

model MockTestAnswer {
  id          Int    @id @default(autoincrement()) @db.UnsignedInt
  questionId  Int    @db.UnsignedInt
  optionId    Int    @db.UnsignedInt
  explanation String @db.Text

  question ExamCategoryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   MockTestOption       @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([questionId]) // One correct answer per question
  @@map("mock_tests_answers")
}

enum TestType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
