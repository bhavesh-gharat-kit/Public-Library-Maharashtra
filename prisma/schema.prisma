// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Library {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  name      String
  email     String  @unique
  contactNo String?
  address   String?

  createdAt DateTime    @default(now())
  User      User[]
  Setting   Setting?
  AllowedIP AllowedIP[]

  @@map("libraries")
}

model Setting {
  id           Int      @id @default(autoincrement())
  libraryId    Int      @unique @db.UnsignedInt
  remoteAccess Boolean  @default(true) // true = allow access from anywhere
  updatedAt    DateTime @updatedAt

  Library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade) //Relation to Library Model

  @@map("library_settings") // Custom table name
}

enum Role {
  user
  admin
  superadmin
}

model User {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  libraryId Int     @db.UnsignedInt
  name      String
  email     String?
  userId    String  @unique
  contactNo String?
  password  String
  role      Role    @default(user)

  Library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("users")
}

model DailyInspiration {
  id     Int    @id @default(autoincrement()) @db.UnsignedInt
  quote  String
  author String

  createdAt DateTime @default(now())

  @@map("daily_inspiration") // Custom table name
}

enum BookType {
  eBook
  iBook
}

enum BookContentType {
  openAccess
  premium
}

model Book {
  id                Int  @id @default(autoincrement()) @db.UnsignedInt
  yearOfPublication Int?

  author    String?
  publisher String?

  medium   String?
  standard String?
  issn     String?
  subject  String?

  syllabus    String?
  title       String?
  description String?
  createdAt   DateTime @default(now())

  contentType BookContentType @default(openAccess)
  bookType    BookType        @default(eBook)

  pdfLink       String?
  thumbnailLink String?

  iBook IBook? @relation("BookToIBook")

  @@map("books") // Custom table name
}

model IBook {
  id     Int  @id @default(autoincrement()) @db.UnsignedInt
  bookId Int  @unique @db.UnsignedInt
  book   Book @relation("BookToIBook", fields: [bookId], references: [id], onDelete: Cascade) //Relation to Book Model

  summary         String? @db.Text
  notes           String? @db.Text
  revisionNotes   String? @db.Text
  commonMistakes  String? @db.Text
  studyTricks     String? @db.Text
  definitions     String? @db.Text
  suggestedVideos String? @db.Text
  mcq             String? @db.Text
  questionPaper   String? @db.Text
  questionAnswer  String? @db.Text

  createdAt DateTime @default(now())

  @@map("i_books") // Custom table name
}

model ExamCategory {
  id        Int        @id @default(autoincrement()) @db.UnsignedInt
  slug      String?    @unique
  name      String
  mockTests MockTest[]
  createdAt DateTime   @default(now())

  @@map("exam_categories") // Custom table name
}

model MockTest {
  id             Int                @id @default(autoincrement()) @db.UnsignedInt
  title          String
  testType       TestType           @default(DAILY)
  examCategoryId Int                @db.UnsignedInt
  examCategory   ExamCategory       @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)
  questions      MockTestQuestion[]

  date      DateTime? @db.Date
  createdAt DateTime  @default(now())

  @@map("mock_tests") // Custom table name
}

model MockTestQuestion {
  id         Int @id @default(autoincrement()) @db.UnsignedInt
  mockTestId Int @db.UnsignedInt

  question String @db.Text

  mockTest MockTest         @relation(fields: [mockTestId], references: [id], onDelete: Cascade) //Relation to MockTest Model
  options  MockTestOption[]
  answer   MockTestAnswer?

  @@map("mock_tests_questions") // Custom table name
}

model MockTestOption {
  id         Int @id @default(autoincrement()) @db.UnsignedInt
  questionId Int @db.UnsignedInt

  text     String
  question MockTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade) //Relation to MockTestQuestion Model
  answer   MockTestAnswer[]

  @@map("mock_tests_options") // Custom table name
}

model MockTestAnswer {
  id         Int @id @default(autoincrement()) @db.UnsignedInt
  questionId Int @db.UnsignedInt
  optionId   Int @db.UnsignedInt

  explanation String @db.Text

  question MockTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade) //Relation to MockTestQuestion Model
  option   MockTestOption   @relation(fields: [optionId], references: [id], onDelete: Cascade) //Relation to MockTestOption Model

  @@unique([questionId])
  @@map("mock_tests_answers") // Custom table name
}

enum TestType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model AllowedIP {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  libraryId Int      @db.UnsignedInt
  ipAddress String   @unique
  createdAt DateTime @default(now())

  Library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade) //Relation to Library Model

  @@map("allowed_ip_addresses") // Custom table name
}

model SuggestedBooks {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  content       String? @db.Text
  url           String?
  title         String?
  description   String?
  thumbnailLink String?

  createdAt DateTime @default(now())

  @@map("suggested_books") // Custom table name
}
